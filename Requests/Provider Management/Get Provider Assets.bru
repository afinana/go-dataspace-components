meta {
  name: Get Provider Assets
  type: http
  seq: 3
}

post {
  url: {{PROVIDER_CP}}/api/mgmt/v4/assets/request
  body: json
  auth: inherit
}

body:json {
  {}
}

assert {
  res.status: eq 200
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response is an array of provider assets", function() {
    expect(res.getBody()).to.be.an('array');
  });
}

