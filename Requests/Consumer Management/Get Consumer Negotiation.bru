meta {
  name: Get Consumer Negotiation
  type: http
  seq: 4
}

get {
  url: {{CONSUMER_CP}}/api/consumer/v4/contractnegotiations/{{CONTRACT_NEGOTIATION_ID}}
  body: none
  auth: inherit
}

script:post-response {
  if (res.getBody()["contractAgreementId"]) {
      bru.setVar("CONTRACT_AGREEMENT_ID", res.getBody()["contractAgreementId"])
  }
}

assert {
  res.status: eq 200
  res.body.@id: isDefined
}

tests {
  test("Status code is 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  test("Response contains contract negotiation details", function () {
      expect(res.getBody()["@id"]).to.be.a('string');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

