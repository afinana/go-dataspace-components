meta {
  name: Download Data via Consumer Proxy
  type: http
  seq: 15
}

get {
  url: {{CONSUMER_DP}}/public/get
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{EDR_TOKEN}}
}

assert {
  res.status: gte 200
  res.status: lte 299
}

tests {
  test("Status code is 200 OK", function () {
      expect(res.getStatus()).to.be.within(200, 299);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

