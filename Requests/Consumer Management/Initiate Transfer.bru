meta {
  name: Initiate Transfer
  type: http
  seq: 9
}

post {
  url: {{CONSUMER_CP}}/api/consumer/v4/transferprocesses
  body: json
  auth: inherit
}

body:json {
  {
    "@context": [
      "https://w3id.org/edc/connector/management/v2"
    ],
    "assetId": "asset-1",
    "@type": "TransferRequest",
    "counterPartyAddress": "{{PROVIDER_DSP}}",
    "connectorId": "{{PROVIDER_ID}}",
    "contractId": "{{CONTRACT_AGREEMENT_ID}}",
    "dataDestination": {
      "@type": "DataAddress",
      "type": "HttpProxy"
    },
    "protocol": "dataspace-protocol-http:2025-1",
    "transferType": "HttpData-PULL"
  }
}

script:pre-request {
  if(!(bru.getVar("CONTRACT_AGREEMENT_ID") !== undefined && bru.getVar("CONTRACT_AGREEMENT_ID") !== null)){
      bru.setVar("CONTRACT_AGREEMENT_ID", "agreement-test-99");
  }
}

script:post-response {
  if (res.getBody() && res.getBody()["@id"]) {
    bru.setVar("TRANSFER_PROCESS_ID", res.getBody()["@id"]);
  }
}

assert {
  res.status: eq 200
  res.body.@id: isDefined
}

tests {
  test("Status code is 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  test("Transfer process ID is returned", function () {
      expect(res.getBody()["@id"]).to.be.a('string');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

